generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BookingStatus {
  confirmed
  completed
  cancelled
  no_show

  @@map("booking_status")
}

enum BookingSource {
  web
  telegram
  admin

  @@map("booking_source")
}

enum TimeOffType {
  day_off
  vacation
  sick
  closure

  @@map("time_off_type")
}

model Service {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String
  durationMin Int     @map("duration_min")
  price       Int
  isActive    Boolean @default(true) @map("is_active")
  sortOrder   Int     @default(0) @map("sort_order")

  barbers  BarberService[]
  bookings BookingService[]

  @@map("services")
}

model Barber {
  id              String  @id @default(uuid()) @db.Uuid
  name            String
  photoUrl        String? @map("photo_url")
  bio             String
  experienceYears Int     @map("experience_years")
  telegramChatId  String? @map("telegram_chat_id")
  isActive        Boolean @default(true) @map("is_active")
  sortOrder       Int     @default(0) @map("sort_order")

  services     BarberService[]
  portfolio    PortfolioItem[]
  workingHours WorkingHour[]
  breaks       Break[]
  timeOff      TimeOff[]
  bookings     Booking[]
  reviews      Review[]

  @@map("barbers")
}

model PortfolioItem {
  id        String @id @default(uuid()) @db.Uuid
  barberId  String @map("barber_id") @db.Uuid
  imageUrl  String @map("image_url")
  sortOrder Int    @default(0) @map("sort_order")

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId])
  @@map("portfolio_items")
}

model BarberService {
  barberId    String  @map("barber_id") @db.Uuid
  serviceId   String  @map("service_id") @db.Uuid
  durationMin Int?    @map("duration_min")
  price       Int?
  isEnabled   Boolean @default(true) @map("is_enabled")

  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@map("barber_services")
}

/// weekday: 0 = воскресенье … 6 = суббота
model WorkingHour {
  id        String   @id @default(uuid()) @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  weekday   Int
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, weekday])
  @@map("working_hours")
}

model Break {
  id        String   @id @default(uuid()) @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  weekday   Int
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, weekday])
  @@map("breaks")
}

model TimeOff {
  id       String      @id @default(uuid()) @db.Uuid
  barberId String?     @map("barber_id") @db.Uuid
  startsAt DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime    @map("ends_at") @db.Timestamptz(3)
  type     TimeOffType
  note     String?

  barber Barber? @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId])
  @@map("time_off")
}

model Client {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  phone          String
  telegramId     String?  @unique @map("telegram_id")
  telegramChatId String?  @map("telegram_chat_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  bookings Booking[]
  reviews  Review[]

  @@map("clients")
}

model Booking {
  id               String        @id @default(uuid()) @db.Uuid
  clientId         String        @map("client_id") @db.Uuid
  barberId         String        @map("barber_id") @db.Uuid
  startsAt         DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime      @map("ends_at") @db.Timestamptz(3)
  timeRange        Unsupported("tstzrange") @default(dbgenerated("tstzrange(starts_at, ends_at, '[)')")) @map("time_range")
  totalPrice       Int           @map("total_price")
  totalDurationMin Int           @map("total_duration_min")
  status           BookingStatus
  source           BookingSource
  manageToken      String        @unique @map("manage_token")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  reminderDaySentAt  DateTime? @map("reminder_day_sent_at") @db.Timestamptz(3)
  reminder30mSentAt  DateTime? @map("reminder_30m_sent_at") @db.Timestamptz(3)
  reviewRequestedAt  DateTime? @map("review_requested_at") @db.Timestamptz(3)
  autoCompletedAt    DateTime? @map("auto_completed_at") @db.Timestamptz(3)

  client   Client           @relation(fields: [clientId], references: [id])
  barber   Barber           @relation(fields: [barberId], references: [id])
  services BookingService[]
  review   Review?

  @@index([barberId, startsAt])
  @@index([clientId])
  @@map("bookings")
}

model BookingService {
  id          String @id @default(uuid()) @db.Uuid
  bookingId   String @map("booking_id") @db.Uuid
  serviceId   String @map("service_id") @db.Uuid
  name        String
  durationMin Int    @map("duration_min")
  price       Int

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@index([bookingId])
  @@map("booking_services")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @unique @map("booking_id") @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  rating    Int
  comment   String?
  isPublic  Boolean  @default(false) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  barber  Barber  @relation(fields: [barberId], references: [id])
  client  Client  @relation(fields: [clientId], references: [id])

  @@index([barberId])
  @@map("reviews")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}

model AdminUser {
  id             String  @id @default(uuid()) @db.Uuid
  login          String  @unique
  passwordHash   String  @map("password_hash")
  telegramChatId String? @map("telegram_chat_id")

  @@map("admin_users")
}
