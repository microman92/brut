# Transaction pooler Supabase, порт 6543. Эту строку использует приложение.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Прямое подключение, порт 5432. Эту строку использует Prisma Migrate.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Project Settings → API. Ключ service_role используйте только на сервере,
# в Vercel для web и в Supabase secrets для Edge Function.
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# Публичное хранилище фотографий создаётся через supabase/storage.sql.
# Хранилище barber-images создаётся через supabase/storage.sql.

# Fastify. Сайт ходит сюда с сервера Next, не из браузера.
API_URL="http://localhost:4000"
# Эти два адреса используются клиентскими запросами с сайта и Mini App.
NEXT_PUBLIC_API_URL="http://localhost:4000"
VITE_API_URL="http://localhost:4000"
# Через запятую, без конечного слэша. В production укажите оба домена Vercel.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# BotFather. Нужен, чтобы Mini App проверял initData и бот слал сообщения.
TELEGRAM_BOT_TOKEN=""

# HTTPS Mini App. Кнопка меню бота открывает этот адрес.
MINIAPP_URL=""

# Если пусто, локально бот получает сообщения через long polling.
# Для деплоя: https://<api>/telegram/webhook
TELEGRAM_WEBHOOK_URL=""
TELEGRAM_WEBHOOK_SECRET=""

# Секрет одноразовой ссылки привязки барбера. POST /api/v1/telegram/barber-links
BARBER_BIND_SECRET=""

# Секрет запуска напоминаний. POST /internal/notifications и заголовок Edge Function.
CRON_SECRET=""

# Первый администратор. Создаётся один раз, если в базе ещё нет admin_users.
ADMIN_LOGIN=""
ADMIN_PASSWORD=""
SESSION_SECRET=""
